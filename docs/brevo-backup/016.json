 "htmlContent": "<!DOCTYPE html>\n<html lang=\"es\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <meta name=\"x-apple-disable-message-reformatting\" />\n  <meta name=\"color-scheme\" content=\"light only\" />\n  <meta name=\"supported-color-schemes\" content=\"light only\" />\n  <title>Código de inicio de sesión único — ROUT</title>\n  <!--[if mso]>\n  <noscript>\n    <xml>\n      <o:OfficeDocumentSettings>\n        <o:PixelsPerInch>96</o:PixelsPerInch>\n      </o:OfficeDocumentSettings>\n    </xml>\n  </noscript>\n  <![endif]-->\n  <style type=\"text/css\">\n    :root {\n      color-scheme: light only;\n      supported-color-schemes: light only;\n    }\n    body {\n      margin: 0 !important;\n      padding: 0 !important;\n      width: 100% !important;\n      -webkit-text-size-adjust: 100%;\n      -ms-text-size-adjust: 100%;\n    }\n    table, td {\n      mso-table-lspace: 0pt;\n      mso-table-rspace: 0pt;\n    }\n    img {\n      border: 0;\n      height: auto;\n      line-height: 100%;\n      outline: none;\n      text-decoration: none;\n      -ms-interpolation-mode: bicubic;\n    }\n    @media only screen and (max-width: 600px) {\n      .rout-card {\n        border-radius: 12px !important;\n      }\n      .rout-padding {\n        padding: 24px 18px !important;\n      }\n    }\n  </style>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #f6f6f4; -webkit-font-smoothing: antialiased;\">\n  <!-- Hidden Preheader + White Space Hack -->\n  <div style=\"display: none; max-height: 0px; overflow: hidden; opacity: 0; font-size: 1px; line-height: 1px; color: #ffffff; mso-hide: all;\">\n    Use su código de 6 dígitos o haga clic en el botón para iniciar sesión en ROUT. &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; \n  </div>\n\n  <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #f6f6f4; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;\">\n    <tr>\n      <td align=\"center\" style=\"padding: 40px 16px;\">\n        <!--[if mso]>\n        <table role=\"presentation\" align=\"center\" width=\"520\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\"><tr><td>\n        <![endif]-->\n        \n        <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" class=\"rout-card\" style=\"max-width: 520px; background-color: #ffffff; border: 1px solid #e6e6e1; border-radius: 20px; overflow: hidden;\">\n          \n          <!-- Header -->\n          <tr>\n            <td class=\"rout-padding\" style=\"padding: 28px 28px 20px 28px; border-bottom: 1px solid #f0f0ec;\">\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n                <tr>\n                  <td valign=\"top\" width=\"42\">\n                    <a href=\"https://rout.be\" target=\"_blank\" style=\"text-decoration: none;\">\n                      <img src=\"https://rout.be/img/rout-bunny.png\" width=\"34\" height=\"34\" alt=\"ROUT\" style=\"display: block; border: 0;\">\n                    </a>\n                  </td>\n                  <td valign=\"top\">\n                    <div style=\"font-weight: 600; font-size: 16px; line-height: 1.2; letter-spacing: 0.14em; color: #111111; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\">ROUT</div>\n                    <div style=\"font-size: 12px; color: #777777; margin-top: 3px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\">Infraestructura soberana</div>\n                  </td>\n                  <td valign=\"top\" align=\"right\" style=\"font-weight: 500; font-size: 11px; line-height: 1.2; color: #3b82f6; letter-spacing: 0.05em; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\">\n                    <span style=\"font-size: 12px;\">•</span> NODO DE AUTENTICACIÓN\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Content Body -->\n          <tr>\n            <td class=\"rout-padding\" style=\"padding: 28px 28px 24px 28px; font-size: 14px; line-height: 22px; color: #222222; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\">\n              <h1 style=\"margin: 0 0 12px 0; font-size: 20px; line-height: 28px; font-weight: 700; color: #111111; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\">Código de inicio de sesión único</h1>\n              \n              <p style=\"margin: 0 0 20px 0; color: #444444; font-size: 14px; line-height: 22px;\">\n                Introduzca el siguiente código de 6 dígitos en la pantalla de inicio de sesión o haga clic en el botón para iniciar sesión directamente en <strong>ROUT</strong>.\n              </p>\n\n              <!-- 6-digit Code Box -->\n              <table role=\"presentation\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #fafafa; border: 1px solid #eaeaea; border-radius: 12px; margin: 0 0 24px 0; text-align: center;\">\n                <tr>\n                  <td style=\"padding: 20px 16px;\">\n                    <div style=\"font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #888888; margin-bottom: 8px;\">SU CÓDIGO DE INICIO DE SESIÓN</div>\n                    <div style=\"font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 32px; font-weight: 700; letter-spacing: 0.25em; color: #111111; padding-left: 0.25em;\">\n                      {{ params.CODE | default: params.code | default: params.token | default: \"______\" }}\n                    </div>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Action Button -->\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin-bottom: 24px;\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"{{ params.MAGIC_LINK | default: params.url | default: params.link | default: 'https://rout.be/auth' }}\" target=\"_blank\" style=\"display: inline-block; background-color: #111111; color: #ffffff; text-decoration: none; padding: 13px 26px; border-radius: 10px; font-size: 14px; font-weight: 600; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: -0.01em;\">\n                      Iniciar sesión en ROUT &rarr;\n                    </a>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Raw Link Box -->\n              <div style=\"font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #888888; margin-bottom: 6px;\">O utilice esta URL directa:</div>\n              <table role=\"presentation\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color: #ffffff; border: 1px solid #eaeaea; border-radius: 8px; margin-bottom: 20px;\">\n                <tr>\n                  <td style=\"padding: 10px 14px; font-size: 11px; line-height: 16px; color: #666666; word-break: break-all; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\">\n                    {{ params.MAGIC_LINK | default: params.url | default: params.link | default: \"https://rout.be/auth\" }}\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Security Notice -->\n              <p style=\"margin: 0 0 16px 0; color: #777777; font-size: 12px; line-height: 18px;\">\n                🔒 Este código y enlace son válidos durante <strong>15 minutos</strong> y solo se pueden utilizar una vez. Si no ha solicitado este intento de inicio de sesión, puede ignorar este mensaje con total seguridad.\n              </p>\n\n              <!-- Signature -->\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top: 20px;\">\n                <tr>\n                  <td style=\"border-left: 3px solid #111111; padding-left: 14px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\">\n                    <div style=\"font-weight: 700; font-size: 14px; color: #111111;\">Autenticación ROUT</div>\n                    <div style=\"font-size: 12px; color: #666666; margin-top: 2px;\">Capa de seguridad e identidad</div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td class=\"rout-padding\" style=\"padding: 20px 28px 28px 28px; background-color: #fafafa; border-top: 1px solid #f0f0ec; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\">\n              \n              <!-- Social Icons -->\n              <table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom: 20px;\">\n                <tr>\n                  <td style=\"padding-right: 12px;\" valign=\"middle\">\n                    <a href=\"https://github.com/routbe\" target=\"_blank\" style=\"text-decoration: none;\"><img src=\"https://a.favicon.im/github.com?larger=true\" width=\"16\" height=\"16\" alt=\"GitHub\" style=\"display: block; border: 0; border-radius: 3px;\"></a>\n                  </td>\n                  <td style=\"padding-right: 12px;\" valign=\"middle\">\n                    <a href=\"https://bsky.app/profile/rout.be\" target=\"_blank\" style=\"text-decoration: none;\"><img src=\"https://a.favicon.im/bsky.app?larger=true\" width=\"16\" height=\"16\" alt=\"Bluesky\" style=\"display: block; border: 0; border-radius: 3px;\"></a>\n                  </td>\n                  <td style=\"padding-right: 12px;\" valign=\"middle\">\n                    <a href=\"https://mastodon.social/@routbe\" target=\"_blank\" style=\"text-decoration: none;\"><img src=\"https://a.favicon.im/mastodon.social?larger=true\" width=\"16\" height=\"16\" alt=\"Mastodon\" style=\"display: block; border: 0; border-radius: 3px;\"></a>\n                  </td>\n                  <td style=\"padding-right: 12px;\" valign=\"middle\">\n                    <a href=\"https://linkedin.com/company/routbe\" target=\"_blank\" style=\"text-decoration: none;\"><img src=\"https://a.favicon.im/linkedin.com?larger=true\" width=\"16\" height=\"16\" alt=\"LinkedIn\" style=\"display: block; border: 0; border-radius: 3px;\"></a>\n                  </td>\n                  <td style=\"padding-right: 12px;\" valign=\"middle\">\n                    <a href=\"https://instagram.com/rout.be\" target=\"_blank\" style=\"text-decoration: none;\"><img src=\"https://a.favicon.im/instagram.com?larger=true\" width=\"16\" height=\"16\" alt=\"Instagram\" style=\"display: block; border: 0; border-radius: 3px;\"></a>\n                  </td>\n                  <td valign=\"middle\">\n                    <a href=\"https://eyou.social/u/rout\" target=\"_blank\" style=\"text-decoration: none;\"><img src=\"https://a.favicon.im/eyou.social?larger=true\" width=\"16\" height=\"16\" alt=\"Eyou\" style=\"display: block; border: 0; border-radius: 3px;\"></a>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Links -->\n              <div style=\"font-size: 12px; line-height: 1.6; color: #666666; margin-bottom: 16px;\">\n                <a href=\"https://rout.be\" target=\"_blank\" style=\"color: #111111; text-decoration: none;\">rout.be</a> \n                <span style=\"color: #cccccc; margin: 0 8px;\">·</span> \n                <a href=\"https://rout.be/privacy\" target=\"_blank\" style=\